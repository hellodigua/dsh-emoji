{
  "name": "@dsh-external/dsh-emoji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Agent 回复中的语义化微型行内表情插件",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/emoji/deepseek",
    "assets/readme",
    "lib",
    "ASSETS.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json --emitDeclarationOnly && tsdown",
    "clean": "node scripts/clean.mjs",
    "slice:deepseek": "python3 scripts/slice-deepseek-sheet.py",
    "sync:bilibili": "node scripts/sync-bilibili-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-remotes": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../test-hellodigua/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:../test-hellodigua/packages/api/remotes",
    "@deepseek-ai/dsh-client-connection": "link:../test-hellodigua/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../test-hellodigua/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:../test-hellodigua/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "link:../test-hellodigua/packages/client/ui-settings-plugins",
    "@deepseek-ai/dsh-client-ui-slots": "link:../test-hellodigua/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-apiproxy": "link:../test-hellodigua/packages/host/apiproxy",
    "@deepseek-ai/dsh-host-webserver": "link:../test-hellodigua/packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:../test-hellodigua/packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:../test-hellodigua/packages/settings/settings",
    "@deepseek-ai/dsh-system-prompt": "link:../test-hellodigua/packages/core/system-prompt",
    "@deepseek-ai/schemastery": "link:../test-hellodigua/vendor/schemastery",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
